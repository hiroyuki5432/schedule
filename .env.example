# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=schedule

# Backend
# (docker-compose では DATABASE_URL を db サービス向けに上書きする)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/schedule
SESSION_SECRET=change-me-in-prod-please-use-a-long-random-string
# 初回起動時にデモ組織・ユーザー・シートを投入するか
SEED_ON_STARTUP=true

# デモ管理者ログイン（seed で作成）
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=demo1234

# Frontend
VITE_API_BASE=/api
