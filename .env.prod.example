# Production environment for docker-compose.prod.yml.
# Copy to `.env` ON THE SERVER and fill in real values. Never commit the real .env.

# --- Database (choose a strong password) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=schedule

# --- Backend ---
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=CHANGE_ME_long_random_hex
# True because the site is served over HTTPS (host nginx) → Secure session cookie.
COOKIE_SECURE=true

# Seed the FIRST admin on the very first boot, then set this to false and redeploy.
# These become the real initial admin account (change the password after login).
SEED_ON_STARTUP=true
DEMO_ADMIN_EMAIL=you@your-company.com
DEMO_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# --- Images (GHCR) — replace <owner>/<repo> with your GitHub repo path ---
BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:latest
FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:latest
